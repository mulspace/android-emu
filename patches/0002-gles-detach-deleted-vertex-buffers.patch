+
+// Regression: a deleted, unused VBO must not be dereferenced as a host pointer.
+namespace emugl {
+class DeletedVertexBufferTest : public GLTest {
+protected:
+    void SetUp() override {
+        setupStandaloneLibrarySearchPaths();
+        const EGLDispatch* egl = LazyLoadedEGLDispatch::get();
+        gl = LazyLoadedGLESv2Dispatch::get();
+        ASSERT_TRUE(egl && gl);
+        m_display = getDisplay();
+        egl->eglSetMaxGLESVersion(2);
+        m_config = createConfig(m_display, 8, 8, 8, 8, 24, 8, 0);
+        m_surface = pbufferSurface(m_display, m_config, 32, 32);
+        m_context = createContext(m_display, m_config, 2, 0);
+        ASSERT_TRUE(egl->eglMakeCurrent(m_display, m_surface, m_surface, m_context));
+    }
+};
+
+TEST_F(DeletedVertexBufferTest, ClientDrawAfterDeletingUnusedBuffer) {
+    ASSERT_EQ(GL_NO_ERROR, gl->glGetError()) << "initial context";
+    fprintf(stderr, "GLTEST version=%s\n", gl->glGetString(GL_VERSION));
+    const char* vertex = "attribute vec2 position; void main() { gl_Position=vec4(position,0.,1.); }";
+    const char* fragment = "precision mediump float; void main() { gl_FragColor=vec4(0.,1.,0.,1.); }";
+    GLuint vs = gl->glCreateShader(GL_VERTEX_SHADER);
+    GLuint fs = gl->glCreateShader(GL_FRAGMENT_SHADER);
+    gl->glShaderSource(vs, 1, &vertex, nullptr);
+    gl->glShaderSource(fs, 1, &fragment, nullptr);
+    gl->glCompileShader(vs);
+    gl->glCompileShader(fs);
+    GLint ok = 0;
+    gl->glGetShaderiv(vs, GL_COMPILE_STATUS, &ok);
+    ASSERT_EQ(1, ok);
+    gl->glGetShaderiv(fs, GL_COMPILE_STATUS, &ok);
+    ASSERT_EQ(1, ok);
+    GLuint program = gl->glCreateProgram();
+    gl->glAttachShader(program, vs);
+    gl->glAttachShader(program, fs);
+    gl->glBindAttribLocation(program, 0, "position");
+    gl->glLinkProgram(program);
+    gl->glGetProgramiv(program, GL_LINK_STATUS, &ok);
+    ASSERT_EQ(1, ok);
+    gl->glUseProgram(program);
+    ASSERT_EQ(GL_NO_ERROR, gl->glGetError()) << "program";
+
+    GLuint buffer;
+    gl->glGenBuffers(1, &buffer);
+    gl->glBindBuffer(GL_ARRAY_BUFFER, buffer);
+    const GLfloat storage[16] = {};
+    gl->glBufferData(GL_ARRAY_BUFFER, sizeof(storage), storage, GL_STATIC_DRAW);
+    gl->glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, 16, reinterpret_cast<void*>(8));
+    gl->glEnableVertexAttribArray(1);
+    ASSERT_EQ(GL_NO_ERROR, gl->glGetError()) << "buffer attribute";
+
+    const GLfloat positions[] = {-1,-1, 1,-1, -1,1, 1,1};
+    gl->glBindBuffer(GL_ARRAY_BUFFER, 0);
+    ASSERT_EQ(GL_NO_ERROR, gl->glGetError()) << "unbind";
+    gl->glVertexAttribPointerWithDataSize(0, 2, GL_FLOAT, GL_FALSE, 0, positions, sizeof(positions));
+    ASSERT_EQ(GL_NO_ERROR, gl->glGetError()) << "client pointer";
+    gl->glEnableVertexAttribArray(0);
+    ASSERT_EQ(GL_NO_ERROR, gl->glGetError());
+    gl->glViewport(0, 0, 32, 32);
+    gl->glClearColor(1, 0, 0, 1);
+    gl->glClear(GL_COLOR_BUFFER_BIT);
+    gl->glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    gl->glFinish();
+    ASSERT_EQ(GL_NO_ERROR, gl->glGetError());
+
+    gl->glDeleteBuffers(1, &buffer);
+    GLint binding = -1;
+    gl->glGetVertexAttribiv(1, GL_VERTEX_ATTRIB_ARRAY_BUFFER_BINDING, &binding);
+    EXPECT_EQ(0, binding);
+    GLint enabled = 0;
+    gl->glGetVertexAttribiv(1, GL_VERTEX_ATTRIB_ARRAY_ENABLED, &enabled);
+    EXPECT_EQ(1, enabled);
+    GLvoid* retainedOffset = nullptr;
+    gl->glGetVertexAttribPointerv(1, GL_VERTEX_ATTRIB_ARRAY_POINTER, &retainedOffset);
+    EXPECT_EQ(reinterpret_cast<void*>(8), retainedOffset);
+    gl->glClear(GL_COLOR_BUFFER_BIT);
+    gl->glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    gl->glFinish();
+    GLubyte pixel[4] = {};
+    gl->glReadPixels(16, 16, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, pixel);
+    EXPECT_EQ(GL_NO_ERROR, gl->glGetError());
+    EXPECT_EQ(0, pixel[0]);
+    EXPECT_EQ(255, pixel[1]);
+    EXPECT_EQ(0, pixel[2]);
+    gl->glDisableVertexAttribArray(0);
+    gl->glDisableVertexAttribArray(1);
+    gl->glUseProgram(0);
+    gl->glDeleteProgram(program);
+    gl->glDeleteShader(vs);
+    gl->glDeleteShader(fs);
+}
