From: android-emu maintainers
Subject: [PATCH] Bound TCG blocks and retry oversized blocks without wrapping offsets

Backport/adaptation of upstream QEMU commits by Richard Henderson:
  abebf92597186be2bc48d487235da28b1127860f (track/limit IR operations)
  9f754620651d3432114f4bb89c7f12cbea814b3e (4000-operation soft limit)
  8b86d6d25807e13a63ab6ea879f976b9f18cc45a (explicit translation bound)
  6e6c4efed995d9eca6ae0cfdb2252df830262f50 (retry oversized TBs)

The older Android fork retains per-target instruction-limit calculation;
pass an additional upper bound and preserve those existing target limits.
Use a hard failure even with NDEBUG for a single overflowing instruction.
Reserve the 0xffff jump-offset sentinel. No guest APK or security check is changed.
QEMU source modifications remain under the original GPL-2.0-or-later terms.

diff --git a/accel/tcg/translate-all.c b/accel/tcg/translate-all.c
--- a/accel/tcg/translate-all.c
+++ b/accel/tcg/translate-all.c
@@ -1269,6 +1269,7 @@
     target_ulong virt_page2;
     tcg_insn_unit *gen_code_buf;
     int gen_code_size, search_size;
+    int max_insns = TCG_MAX_INSNS;
 #ifdef CONFIG_PROFILER
     TCGProfile *prof = &tcg_ctx->prof;
     int64_t ti;
@@ -1297,6 +1298,8 @@
     tb->trace_vcpu_dstate = *cpu->trace_dstate;
     tcg_ctx->tb_cflags = cflags;
 
+ tb_overflow:
+
 #ifdef CONFIG_PROFILER
     /* includes aborted translations because of exceptions */
     atomic_set(&prof->tb_count1, prof->tb_count1 + 1);
@@ -1306,7 +1309,7 @@
     tcg_func_start(tcg_ctx);
 
     tcg_ctx->cpu = ENV_GET_CPU(env);
-    gen_intermediate_code(cpu, tb);
+    gen_intermediate_code(cpu, tb, max_insns);
     tcg_ctx->cpu = NULL;
 
     trace_translate_block(tb, tb->pc, tb->tc.ptr);
@@ -1336,6 +1339,15 @@
        re-initialize it per above, and re-do the actual code generation.  */
     gen_code_size = tcg_gen_code(tcg_ctx, tb);
     if (unlikely(gen_code_size < 0)) {
+        if (gen_code_size == -2) {
+            /* A single TB, not the shared code buffer, is too large.
+             * Preserve cflags/hash identity and retry with fewer insns. */
+            if (tb->icount <= 1) {
+                cpu_abort(cpu, "TCG single instruction exceeds 16-bit TB offsets");
+            }
+            max_insns = tb->icount / 2;
+            goto tb_overflow;
+        }
         goto buffer_overflow;
     }
     search_size = encode_search(tb, (void *)gen_code_buf + gen_code_size);
