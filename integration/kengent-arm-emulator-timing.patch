@@ -0,0 +1,113 @@
+import asyncio
+import json
+from contextlib import asynccontextmanager
+from types import SimpleNamespace
+
+import pytest
+
+from kengent.tools.resource_node import android
+from kengent.tools.resource_node.android_timing import timing_for, validate_profiles
+from kengent.tools.resource_node.discovery import DeviceDiscovery
+
+
+@pytest.mark.parametrize("serial,profile", [
+    ("physical-usb", "arm-emulator"), ("127.0.0.1:5555", "arm-emulator"),
+    ("emulator-5576", "unbounded"), ("emulator-5576/../device", "arm-emulator"),
+])
+def test_extended_read_timing_cannot_be_enabled_for_a_phone(serial, profile):
+    with pytest.raises(ValueError):
+        timing_for(serial, profile)
+
+
+def test_default_device_timing_and_explicit_profile():
+    assert timing_for("physical-usb").identity_seconds == 8
+    assert timing_for("emulator-5576").snapshot_seconds == 8
+    profile = timing_for("emulator-5576", "arm-emulator")
+    assert (profile.identity_seconds, profile.snapshot_seconds, profile.settle_seconds) == (30, 30, 2)
+    with pytest.raises(ValueError):
+        validate_profiles({"emulator-5576": 30})
+
+
+def test_profile_is_forwarded_only_to_explicit_locator():
+    discovery = DeviceDiscovery(
+        node=SimpleNamespace(backends={}), inventory=SimpleNamespace(all=lambda: []),
+        node_id="fixture", adb_path="fixture-adb", artifacts=(), packages=["example.app"],
+        artifact_sink=None, registrar=None, transport_factory=lambda **kwargs: kwargs,
+        timing_profiles={"emulator-5576": "arm-emulator"},
+    )
+    assert discovery._transport("emulator-5576")["timing_profile"] == "arm-emulator"
+    assert "timing_profile" not in discovery._transport("emulator-5578")
+    assert "timing_profile" not in discovery._transport("physical-usb")
+
+
+@pytest.mark.asyncio
+async def test_emulator_profile_changes_only_snapshot_rpc_deadline(monkeypatch):
+    deadlines = []
+    @asynccontextmanager
+    async def deadline(seconds):
+        deadlines.append(seconds)
+        yield
+    monkeypatch.setattr(android.asyncio, "timeout", deadline)
+    class Input:
+        def write(self, value):
+            pass
+        async def drain(self):
+            pass
+    transport = SimpleNamespace(timing=timing_for("emulator-5576", "arm-emulator"))
+    session = android.NativeSession(transport, {"nonce": "0" * 32}, ["example.app"])
+    session.process = SimpleNamespace(returncode=None, stdin=Input())
+    async def response(*, expected_id=None, private_input=False):
+        return {"id": expected_id, "ok": True, "result": {}}
+    monkeypatch.setattr(session, "_read", response)
+    for operation in ("android.snapshot", "android.tap", "android.start_app", "android.credential_text"):
+        await session.call(operation, {"arguments": {}})
+    assert deadlines == [30, 8, 8, 8]
+
+
+@pytest.mark.asyncio
+async def test_identity_uses_explicit_profile_without_changing_fingerprint(monkeypatch):
+    results, waits = [], []
+    for profile in ("standard", "arm-emulator"):
+        transport = android.AdbTransport(adb_path="fixture", serial="emulator-5576", artifacts=(), timing_profile=profile)
+        async def shell(script, *, timeout):
+            waits.append(timeout)
+            return b"known-fixture-serial\n0123456789abcdef\nfixture-model\npackage:example.app\n"
+        monkeypatch.setattr(transport, "shell", shell)
+        results.append(await transport.identify())
+    assert waits == [8, 30] and results[0] == results[1]
+
+
+def test_long_snapshot_diagnostic_must_fit_observed_call():
+    timings = dict(guard_before_ms=6630, capture_ms=122, guard_after_ms=3511, encoding_ms=266, total_ms=10604)
+    assert android._snapshot_timings(timings, 10830) == timings
+    assert android._snapshot_timings(timings, 8000) is None
+    assert android._snapshot_timings({**timings, "total_ms": 30001}, 40000) is None
+
+
+@pytest.mark.parametrize("profiles", [
+    {"physical-usb": "standard"}, {"physical-usb": "arm-emulator"},
+    {"emulator-5576": "infinite"}, {"emulator-5576\n": "standard"},
+    {"emulator-5576": 30}, [],
+])
+def test_invalid_profile_map_is_rejected_before_discovery(profiles):
+    with pytest.raises(ValueError):
+        validate_profiles(profiles)
+
+
+@pytest.mark.parametrize("profile,valid", [("arm-emulator", True), ("standard", True), ("infinite", False)])
+def test_host_settings_accept_only_declared_bounded_profiles(tmp_path, profile, valid):
+    from app.agents.host.main import load_settings
+    settings = {
+        "node_id": "offline-fixture", "state_root": "state", "cache_root": "cache",
+        "sdk_root": "sdk", "adb_path": "fixture", "platform_url": "http://127.0.0.1:1",
+        "public_url": "http://127.0.0.1:2", "registration_context_file": "context.json",
+        "allowed_packages": ["example.public"],
+        "android_timing_profiles": {"emulator-5576": profile},
+    }
+    path = tmp_path / "host.json"
+    path.write_text(json.dumps(settings))
+    if valid:
+        assert load_settings(path)["android_timing_profiles"] == settings["android_timing_profiles"]
+    else:
+        with pytest.raises(ValueError):
+            load_settings(path)
