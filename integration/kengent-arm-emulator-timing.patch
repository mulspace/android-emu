@@ -0,0 +1,31 @@
+"""Explicit host-owned read timing; physical input deadlines are unchanged."""
+
+from dataclasses import dataclass
+import re
+
+
+@dataclass(frozen=True)
+class AndroidTiming:
+    identity_seconds: int = 8
+    snapshot_seconds: int = 8
+    settle_seconds: int = 0
+
+
+def timing_for(serial: str, profile: str = "standard") -> AndroidTiming:
+    if profile == "standard":
+        return AndroidTiming()
+    if profile != "arm-emulator" or not re.fullmatch(r"emulator-[0-9]{4,5}", serial):
+        raise ValueError("Extended Android read timing requires an explicit emulator locator")
+    return AndroidTiming(identity_seconds=30, snapshot_seconds=30, settle_seconds=2)
+
+
+def validate_profiles(profiles: object) -> dict[str, str]:
+    if not isinstance(profiles, dict) or len(profiles) > 100:
+        raise ValueError("Invalid Android timing profiles")
+    for serial, profile in profiles.items():
+        if not isinstance(serial, str) or not isinstance(profile, str):
+            raise ValueError("Invalid Android timing profile")
+        if not re.fullmatch(r"emulator-[0-9]{4,5}", serial):
+            raise ValueError("Android timing profiles require an explicit emulator locator")
+        timing_for(serial, profile)
+    return dict(profiles)
