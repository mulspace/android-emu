+@pytest.mark.asyncio
+@pytest.mark.parametrize("profile,deadline", [("standard", 6), ("arm-emulator", 30)])
+@pytest.mark.parametrize("acknowledged", [False, True])
+async def test_cleanup_profile_waits_for_same_nonce_ack_without_replaying(monkeypatch, profile, deadline, acknowledged):
+    transport = android.AdbTransport(adb_path="fixture", serial="emulator-5576", artifacts=(), timing_profile=profile)
+    calls = []
+    nonce = "a" * 32
+    async def verified():
+        pass
+    async def prepared(**kwargs):
+        assert kwargs == {"include_engine": False}
+        return "fixture-bridge"
+    async def shell(command, *, timeout):
+        calls.append((command, timeout))
+        return ("closed:" + (nonce if acknowledged else "b" * 32)).encode()
+    monkeypatch.setattr(transport, "verify", verified)
+    monkeypatch.setattr(transport, "prepare", prepared)
+    monkeypatch.setattr(transport, "shell", shell)
+    if acknowledged:
+        await transport.close_nonce(nonce)
+    else:
+        with pytest.raises(android.ServiceFault, match="generation tombstone"):
+            await transport.close_nonce(nonce)
+    assert calls == [("fixture-bridge close " + nonce, deadline)]
+
+
