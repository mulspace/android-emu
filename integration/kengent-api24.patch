+package club.lang.resources;
+
+import android.os.Build;
+
+/** Resolve the Binder service before an action; never retry a physical action. */
+public final class ActivityManagerAccess {
+    private ActivityManagerAccess() {}
+
+    public static Object get() throws Exception {
+        if (Build.VERSION.SDK_INT < 24) throw new IllegalStateException();
+        if (Build.VERSION.SDK_INT < 26) {
+            return Class.forName("android.app.ActivityManagerNative")
+                    .getMethod("getDefault").invoke(null);
+        }
+        return Class.forName("android.app.ActivityManager")
+                .getMethod("getService").invoke(null);
+    }
+}
