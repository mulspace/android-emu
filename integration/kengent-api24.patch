+import hashlib
+
+import pytest
+
+from kengent.contracts.service_api import ServiceFault
+from kengent.tools.resource_node import android
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("mode", ["sha256", "readback", "missing", "corrupt"])
+async def test_artifact_verification_before_launch(tmp_path, monkeypatch, mode):
+    artifact = tmp_path / "bridge.jar"
+    artifact.write_bytes(b"exact-jar-bytes")
+    digest = hashlib.sha256(artifact.read_bytes()).hexdigest()
+    transport = android.AdbTransport(adb_path="adb", serial="isolated-test", artifacts=(artifact, artifact))
+    pushes, reads = [], []
+
+    async def shell(script, *, timeout):
+        assert "command -v sha256sum" in script
+        if mode == "sha256":
+            return f"{digest}  /data/local/tmp/test.jar\n".encode()
+        if mode == "missing" and not pushes:
+            return b""
+        return b"readback\n"
+
+    async def run(command, *, timeout, limit=None):
+        assert command[:3] == ["adb", "-s", "isolated-test"]
+        if command[3] == "push":
+            pushes.append(command)
+            return b""
+        assert command[3:5] == ["exec-out", "cat"]
+        assert command[5] == "/data/local/tmp/kengent-resource-" + digest + ".jar"
+        assert limit == len(artifact.read_bytes()) and timeout == 20
+        reads.append(command)
+        return b"corrupt" if mode == "corrupt" else artifact.read_bytes()
+
+    monkeypatch.setattr(transport, "shell", shell)
+    monkeypatch.setattr(android, "run_bounded", run)
+    if mode == "corrupt":
+        with pytest.raises(ServiceFault) as caught:
+            await transport.prepare(include_engine=False)
+        assert caught.value.problem()["code"] == "native_artifact_mismatch"
+        assert len(pushes) == 1 and len(reads) == 2
+    else:
+        launch = await transport.prepare(include_engine=False)
+        assert "kengent-resource-" + digest + ".jar" in launch
+        assert len(pushes) == (1 if mode == "missing" else 0)
+        assert len(reads) == (0 if mode == "sha256" else 1)
+
+
+@pytest.mark.asyncio
+async def test_readback_failure_is_not_accepted_or_replayed(monkeypatch):
+    transport = android.AdbTransport(adb_path="adb", serial="isolated-test", artifacts=())
+    async def shell(*args, **kwargs):
+        return b"readback\n"
+    async def failure(*args, **kwargs):
+        raise TimeoutError()
+    monkeypatch.setattr(transport, "shell", shell)
+    monkeypatch.setattr(android, "run_bounded", failure)
+    with pytest.raises(TimeoutError):
+        await transport._artifact_digest("/data/local/tmp/bridge.jar", 100)
