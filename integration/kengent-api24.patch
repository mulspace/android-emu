+package club.lang.resources;
+
+import java.util.concurrent.Callable;
+import java.util.concurrent.FutureTask;
+import java.util.concurrent.TimeUnit;
+
+/** One bounded initialization on the Android main loop, never a physical action. */
+public final class MainThreadInit {
+    public interface Queue {
+        boolean post(Runnable task);
+        void remove(Runnable task);
+    }
+
+    private MainThreadInit() {}
+
+    public static <T> T call(Queue queue, Callable<T> initializer, long timeoutMillis) throws Exception {
+        if (timeoutMillis <= 0 || timeoutMillis > 5000) throw new IllegalArgumentException();
+        FutureTask<T> task = new FutureTask<>(initializer);
+        try {
+            if (!queue.post(task)) throw new IllegalStateException();
+            return task.get(timeoutMillis, TimeUnit.MILLISECONDS);
+        } finally {
+            // A timed-out task must not start later. An already executing
+            // constructor is not interrupted or retried; bridge shutdown owns it.
+            task.cancel(false);
+            queue.remove(task);
+        }
+    }
+}
