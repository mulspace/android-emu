+"""The bridge cache must not serve an old API-26 DEX to an API-24 device."""
+
+import hashlib
+from pathlib import Path
+import zipfile
+
+from kengent.tools.resource_node import android
+
+
+def test_native_build_invalidates_old_cache_and_keys_minimum_api(tmp_path, monkeypatch):
+    package = tmp_path / "package"
+    engine = tmp_path / "engine"
+    (package / "native").mkdir(parents=True)
+    (engine / "assets").mkdir(parents=True)
+    source_bytes, engine_bytes = b"class Example {}", b"engine"
+    (package / "native/ResourceDeviceBridge.java").write_bytes(source_bytes)
+    (engine / "assets/u2.jar").write_bytes(engine_bytes)
+    monkeypatch.setattr(android.metadata, "version", lambda name: "3.7.0")
+    monkeypatch.setattr(android.resources, "files", lambda name: engine if name == "uiautomator2" else package)
+    sdk = tmp_path / "sdk"
+    for name in ("build-tools/36/d8", "platforms/34/android.jar"):
+        path = sdk / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.touch()
+    cache = tmp_path / "cache"
+    old = cache / hashlib.sha256(source_bytes + engine_bytes).hexdigest()
+    old.mkdir(parents=True)
+    (old / "bridge.jar").write_bytes(b"incompatible-api26")
+    commands = []
+
+    def compiler(command):
+        commands.append(command)
+        if command[0] == "javac":
+            (Path(command[command.index("-d") + 1]) / "Example.class").write_bytes(b"class")
+        else:
+            minimum = command[command.index("--min-api") + 1]
+            (Path(command[command.index("--output") + 1]) / "classes.dex").write_bytes(minimum.encode())
+
+    monkeypatch.setattr(android, "_build_command", compiler)
+    _, artifact = android.build_native_artifacts(sdk_root=sdk, cache_root=cache)
+    assert artifact.parent != old and len(commands) == 2
+    assert commands[1][commands[1].index("--min-api") + 1] == "24"
+    with zipfile.ZipFile(artifact) as archive:
+        assert archive.read("classes.dex") == b"24"
+    assert android.build_native_artifacts(sdk_root=sdk, cache_root=cache)[1] == artifact
+    assert len(commands) == 2
+    monkeypatch.setattr(android, "NATIVE_MIN_API", 26)
+    _, newer = android.build_native_artifacts(sdk_root=sdk, cache_root=cache)
+    assert newer != artifact and len(commands) == 4
+    assert (old / "bridge.jar").read_bytes() == b"incompatible-api26"
