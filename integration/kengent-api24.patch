+"""Initialization is queued once; failures never replay and queued work expires."""
+
+from pathlib import Path
+import shutil
+import subprocess
+
+import pytest
+
+
+@pytest.fixture(scope="module")
+def init_classes(tmp_path_factory):
+    if not shutil.which("javac") or not shutil.which("java"):
+        pytest.skip("JDK required")
+    root = tmp_path_factory.mktemp("main-thread-init")
+    source = root / "InitProbe.java"
+    source.write_text('''
+import club.lang.resources.MainThreadInit;
+import java.util.concurrent.*;
+public class InitProbe {
+    static void check(boolean ok) { if (!ok) throw new AssertionError(); }
+    static class Queue implements MainThreadInit.Queue {
+        final String mode;
+        Runnable queued;
+        int posts, removes, calls;
+        Thread worker;
+        Queue(String mode) { this.mode = mode; }
+        public boolean post(Runnable task) {
+            posts++; queued = task;
+            if (mode.equals("rejected")) return false;
+            if (mode.equals("timeout")) return true;
+            worker = new Thread(task, "android-main-test"); worker.start(); return true;
+        }
+        public void remove(Runnable task) { check(task == queued); removes++; }
+    }
+    public static void main(String[] args) throws Exception {
+        Queue queue = new Queue(args[0]);
+        String result;
+        try {
+            result = MainThreadInit.call(queue, () -> {
+                queue.calls++;
+                check(Thread.currentThread().getName().equals("android-main-test"));
+                if (queue.mode.equals("error")) throw new SecurityException();
+                return "ready";
+            }, 100);
+        } catch (Exception error) { result = error.getClass().getSimpleName(); }
+        if (queue.worker != null) queue.worker.join(1000);
+        check(queue.posts == 1 && queue.removes == 1);
+        queue.queued.run(); // A delayed or repeated queue callback cannot replay initialization.
+        if (queue.mode.equals("timeout") || queue.mode.equals("rejected")) check(queue.calls == 0);
+        else check(queue.calls == 1);
+        System.out.println(result + ":calls=" + queue.calls);
+    }
+}
+''')
+    native = Path(__file__).resolve().parents[2] / "src/kengent/tools/resource_node/native/MainThreadInit.java"
+    subprocess.run(["javac", "-d", str(root), str(native), str(source)], check=True, capture_output=True, timeout=30)
+    return root
+
+
+@pytest.mark.parametrize("mode,expected", [
+    ("normal", "ready:calls=1"),
+    ("error", "ExecutionException:calls=1"),
+    ("timeout", "TimeoutException:calls=0"),
+    ("rejected", "IllegalStateException:calls=0"),
+])
+def test_main_loop_init_is_bounded_and_not_replayed(init_classes, mode, expected):
+    result = subprocess.run(["java", "-cp", str(init_classes), "InitProbe", mode], capture_output=True, text=True, check=True, timeout=5)
+    assert result.stdout.strip() == expected and result.stderr == ""
