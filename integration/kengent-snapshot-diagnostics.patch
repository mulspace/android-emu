+"""Private snapshot diagnostics must explain rejection without changing acceptance."""
+from pathlib import Path
+import shutil
+import subprocess
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+@pytest.mark.skipif(not shutil.which("javac") or not shutil.which("java"), reason="JDK required")
+def test_snapshot_difference_classification_never_accepts_changed_image(tmp_path):
+    source = ROOT / "src/kengent/tools/resource_node/native/SnapshotCapture.java"
+    probe = tmp_path / "DifferenceProbe.java"
+    probe.write_text(r'''
+import club.lang.resources.SnapshotCapture;
+public final class DifferenceProbe {
+    static void check(boolean value) { if(!value)throw new AssertionError(); }
+    static String clock(String value) {
+        return "<node text=\""+value+"\" resource-id=\"com.android.systemui:id/clock\" "
+            +"package=\"com.android.systemui\" class=\"android.widget.TextView\" "
+            +"clickable=\"false\" password=\"false\" bounds=\"[635,0][704,48]\"/>";
+    }
+    static SnapshotCapture.Observation state(String tree) {
+        return new SnapshotCapture.Observation("public:720:1560:0",tree,false);
+    }
+    static class Port implements SnapshotCapture.Port<String> {
+        SnapshotCapture.Observation[] frames;int reads=0,captures=0,discards=0,pauses=0;
+        Port(SnapshotCapture.Observation... values){frames=values;}
+        public SnapshotCapture.Observation observe(){return frames[reads++];}
+        public String capture(){captures++;return "PRIVATE-PIXELS";}
+        public void discard(String image){check(image.equals("PRIVATE-PIXELS"));discards++;}
+        public void pause(){pauses++;}
+    }
+    static void rejected(String before,String after,String reason,boolean during) throws Exception {
+        SnapshotCapture.Observation original=state(before),changed=state(after);
+        Port p=during?new Port(original,changed):new Port(changed);
+        try { SnapshotCapture.stable(p,original);throw new AssertionError(); }
+        catch(SnapshotCapture.Mismatch error) {
+            check(error.phase.equals("snapshot_"+reason+(during?"during_capture":"before_capture")));
+            check(error.getMessage()==null);
+            check(!error.toString().contains("PRIVATE"));
+        }
+        check(p.pauses==0 && p.captures==(during?1:0) && p.discards==(during?1:0));
+    }
+    public static void main(String[] args) throws Exception {
+        String old=clock("3:50"),next=clock("3:51");
+        for(boolean during:new boolean[]{false,true}) {
+            rejected(old,next,"clock_changed_",during);
+            rejected(old+"<node text=\"PRIVATE-OLD\"/>",next+"<node text=\"PRIVATE-NEW\"/>","changed_",during);
+            rejected(old,next.replace("[635,0]","[634,0]"),"changed_",during);
+            rejected(old.replace("clickable=\"false\"","clickable=\"true\" long-clickable=\"false\""),
+                next.replace("clickable=\"false\"","clickable=\"true\" long-clickable=\"false\""),"changed_",during);
+            rejected(old+old,next+next,"changed_",during);
+            rejected(old.replace("com.android.systemui","app.example"),next.replace("com.android.systemui","app.example"),"changed_",during);
+        }
+        SnapshotCapture.Observation same=state(old);
+        Port p=new Port(same,same);check(SnapshotCapture.stable(p,same).equals("PRIVATE-PIXELS"));
+        check(p.reads==2 && p.captures==1 && p.discards==0);
+    }
+}
+''')
+    subprocess.run(["javac", "-d", str(tmp_path), str(source), str(probe)], check=True, timeout=30)
+    subprocess.run(["java", "-cp", str(tmp_path), "DifferenceProbe"], check=True, timeout=15)
