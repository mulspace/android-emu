+package club.lang.resources;
+
+/** Android 7 can omit global focus while the active window owns a focused field. */
+public final class InputFocus {
+    private InputFocus() {}
+
+    public interface Port<T> {
+        T globalFocus() throws Exception;
+        T activeRoot() throws Exception;
+        T focusIn(T root) throws Exception;
+        String packageOf(T node);
+        void recycle(T node);
+    }
+
+    public static <T> T read(Port<T> port, int sdk, String expectedPackage) throws Exception {
+        if (sdk < 24 || expectedPackage == null || expectedPackage.isEmpty()) throw new IllegalArgumentException();
+        T field = port.globalFocus();
+        if (field != null || sdk >= 26) return field;
+        T root = port.activeRoot();
+        if (root == null) return null;
+        try {
+            if (!expectedPackage.equals(port.packageOf(root))) throw new SecurityException();
+            T local = port.focusIn(root);
+            if (local != null && !expectedPackage.equals(port.packageOf(local))) {
+                port.recycle(local);
+                throw new SecurityException();
+            }
+            return local;
+        } finally { port.recycle(root); }
+    }
+}
