+"""Run the real shim with an API24 class that lacks the API26 methods entirely."""
+from pathlib import Path
+import shutil
+import subprocess
+
+import pytest
+
+NATIVE = Path(__file__).resolve().parents[2] / "src/kengent/tools/resource_node/native"
+
+
+@pytest.fixture(scope="module")
+def compiled_text_access(tmp_path_factory):
+    if not shutil.which("javac") or not shutil.which("java"):
+        pytest.skip("JDK required")
+    root = tmp_path_factory.mktemp("text-access")
+    stub = root / "android/view/accessibility/AccessibilityNodeInfo.java"
+    stub.parent.mkdir(parents=True)
+    base = '''package android.view.accessibility;
+public class AccessibilityNodeInfo {
+  public CharSequence getText() { return System.getProperty("value"); }
+%s
+}
+'''
+    stub.write_text(base % '''public CharSequence getHintText() { return System.getProperty("hint"); }
+public boolean isShowingHintText() { return Boolean.getBoolean("isHint"); }''')
+    probe = root / "TextProbe.java"
+    probe.write_text('''import club.lang.resources.TextFieldAccess;
+import android.view.accessibility.AccessibilityNodeInfo;
+public class TextProbe {
+  public static void main(String[] args) {
+    System.out.print(TextFieldAccess.currentText(new AccessibilityNodeInfo(), Integer.parseInt(args[0])));
+  }
+}''')
+    subprocess.run(["javac", "-d", str(root / "new"), str(stub), str(NATIVE / "TextFieldAccess.java"), str(probe)],
+                   check=True, capture_output=True, timeout=30)
+    # Compile a runtime class which literally has no hint methods. Loading
+    # those methods on API24 would throw NoSuchMethodError in this test.
+    stub.write_text(base % "")
+    subprocess.run(["javac", "-d", str(root / "old"), str(stub)], check=True, capture_output=True, timeout=30)
+    return root
+
+
+@pytest.mark.parametrize("sdk,value,hint,is_hint,expected", [
+    (24, "600999", "600999", True, "600999"),
+    (25, "股票代码/名称", "股票代码/名称", True, "股票代码/名称"),
+    (24, None, None, False, ""),
+    (26, "hint", "hint", False, ""),
+    (26, "placeholder", None, True, ""),
+    (35, "600999", "search", False, "600999"),
+])
+def test_existing_text_preserved_unless_supported_hint_evidence_proves_empty(
+    compiled_text_access, sdk, value, hint, is_hint, expected,
+):
+    root = compiled_text_access
+    properties = [f"-DisHint={str(is_hint).lower()}"]
+    if value is not None:
+        properties.append(f"-Dvalue={value}")
+    if hint is not None:
+        properties.append(f"-Dhint={hint}")
+    classpath = f"{root / 'old'}:{root / 'new'}" if sdk < 26 else str(root / "new")
+    result = subprocess.run(["java", *properties, "-cp", classpath, "TextProbe", str(sdk)],
+                            check=True, capture_output=True, text=True, timeout=5)
+    assert result.stdout == expected
+    assert result.stderr == ""
