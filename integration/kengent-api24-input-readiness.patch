+"""Legacy focus lookup stays within the observed active package and never inputs."""
+from pathlib import Path
+import shutil
+import subprocess
+
+import pytest
+
+NATIVE = Path(__file__).resolve().parents[2] / "src/kengent/tools/resource_node/native"
+
+
+def test_legacy_focus_fallback_preserves_scope_and_recycles_all_roots(tmp_path):
+    if not shutil.which("javac") or not shutil.which("java"):
+        pytest.skip("JDK required")
+    probe = tmp_path / "FocusProbe.java"
+    probe.write_text('''import club.lang.resources.InputFocus;
+public class FocusProbe implements InputFocus.Port<String> {
+    String mode; int roots, focused, recycled;
+    FocusProbe(String mode) { this.mode=mode; }
+    public String globalFocus() {
+        if(mode.equals("error"))throw new IllegalStateException();
+        return mode.equals("global")?"global":null;
+    }
+    public String activeRoot() { roots++;return mode.equals("missing")?null:"root"; }
+    public String focusIn(String root) { focused++;return mode.equals("no_focus")?null:"local"; }
+    public String packageOf(String node) {
+        return (mode.equals("foreign_root")&&node.equals("root") || mode.equals("foreign_field")&&node.equals("local"))?"foreign":"allowed";
+    }
+    public void recycle(String node) { recycled++; }
+    static void check(boolean value) { if(!value)throw new AssertionError(); }
+    static void test(String mode,int sdk,String expected,int roots,int focused,int recycled) throws Exception {
+        FocusProbe p=new FocusProbe(mode);String result;
+        try { result=InputFocus.read(p,sdk,"allowed"); }
+        catch(Exception e) { result=e.getClass().getSimpleName(); }
+        check(java.util.Objects.equals(result,expected));
+        check(p.roots==roots&&p.focused==focused&&p.recycled==recycled);
+    }
+    public static void main(String[] args) throws Exception {
+        test("global",24,"global",0,0,0);
+        test("local",24,"local",1,1,1);
+        test("local",25,"local",1,1,1);
+        test("local",26,null,0,0,0);
+        test("missing",24,null,1,0,0);
+        test("no_focus",24,null,1,1,1);
+        test("foreign_root",24,"SecurityException",1,0,1);
+        test("foreign_field",24,"SecurityException",1,1,2);
+        test("error",24,"IllegalStateException",0,0,0);
+        System.out.println("legacy focus scope passed");
+    }
+}''')
+    subprocess.run(["javac", "-d", str(tmp_path), str(NATIVE / "InputFocus.java"), str(probe)],
+                   check=True, capture_output=True, timeout=30)
+    result = subprocess.run(["java", "-cp", str(tmp_path), "FocusProbe"],
+                            check=True, capture_output=True, text=True, timeout=5)
+    assert result.stdout.strip() == "legacy focus scope passed"
