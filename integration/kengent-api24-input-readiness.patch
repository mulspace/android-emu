@@ -0,0 +1,25 @@
+package club.lang.resources;
+
+import android.view.accessibility.AccessibilityNodeInfo;
+
+/** Read existing text without linking Android 8 hint APIs on Android 7. */
+public final class TextFieldAccess {
+    private TextFieldAccess() {}
+
+    public static String currentText(AccessibilityNodeInfo field, int sdk) {
+        if (field == null || sdk < 24) throw new IllegalArgumentException();
+        CharSequence value = field.getText();
+        String existing = value == null ? "" : value.toString();
+        if (sdk >= 26 && Api26.isHint(field, existing)) return "";
+        // Older nodes cannot prove a string is only a hint. Preserve it so
+        // the bounded ASCII replacement gate can reject ambiguous contents.
+        return existing;
+    }
+
+    private static final class Api26 {
+        static boolean isHint(AccessibilityNodeInfo field, String existing) {
+            CharSequence hint = field.getHintText();
+            return field.isShowingHintText() || hint != null && existing.contentEquals(hint);
+        }
+    }
+}
