+package club.lang.resources;
+
+/** Read-only confirmation of one submitted launch; this class cannot launch or input. */
+public final class LaunchReadiness {
+    private LaunchReadiness() {}
+
+    public interface Port {
+        void check() throws Exception;
+        long now();
+        String foregroundPackage() throws Exception;
+        void pause(long milliseconds) throws Exception;
+    }
+
+    public static void await(Port port, String expectedPackage, int timeoutMs) throws Exception {
+        if (port == null || expectedPackage == null || expectedPackage.isEmpty()
+                || (timeoutMs != 3000 && timeoutMs != 120000)) throw new IllegalArgumentException();
+        long started = port.now();
+        while (port.now() - started < timeoutMs) {
+            port.check();
+            String current = port.foregroundPackage();
+            port.check();
+            long elapsed = port.now() - started;
+            if (elapsed < 0 || elapsed >= timeoutMs) throw new IllegalStateException();
+            if (expectedPackage.equals(current)) return;
+            port.pause(Math.min(timeoutMs == 3000 ? 40 : 250, timeoutMs - elapsed));
+        }
+        throw new IllegalStateException();
+    }
+}
