+"""One launch can await a slow foreground without replay or bypassing its fence."""
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+NATIVE = Path(__file__).resolve().parents[2] / "src/kengent/tools/resource_node/native"
+
+
+@pytest.fixture(scope="module")
+def readiness_classes(tmp_path_factory):
+    if not shutil.which("javac") or not shutil.which("java"):
+        pytest.skip("JDK required")
+    root = tmp_path_factory.mktemp("launch-readiness")
+    probe = root / "Probe.java"
+    probe.write_text('''
+import club.lang.resources.LaunchReadiness;
+public class Probe implements LaunchReadiness.Port {
+    String mode; long clock; int reads, checks;
+    Probe(String mode) { this.mode=mode; }
+    public long now() { return clock; }
+    public void check() { checks++; if (mode.equals("cancel") && clock >= 1000) throw new SecurityException(); }
+    public String foregroundPackage() {
+        reads++;
+        if (mode.equals("denied")) throw new SecurityException();
+        if (mode.equals("slow_read")) { clock=120001; return "expected"; }
+        if (mode.equals("clock_back")) { clock=-1; return "expected"; }
+        if (mode.equals("ready")) return "expected";
+        if (mode.equals("late") && clock >= 93500) return "expected";
+        if (mode.equals("foreign")) return "other.app";
+        return null;
+    }
+    public void pause(long ms) { if (ms<=0 || ms>250) throw new AssertionError(); clock+=ms; }
+    public static void main(String[] args) {
+        Probe p=new Probe(args[0]); String result="ready";
+        try { LaunchReadiness.await(p,"expected",Integer.parseInt(args[1])); }
+        catch (Exception e) { result=e.getClass().getSimpleName(); }
+        System.out.println(result+" time="+p.clock+" reads="+p.reads+" checks="+p.checks);
+    }
+}
+''')
+    subprocess.run(["javac", "-d", str(root), str(NATIVE/"LaunchReadiness.java"), str(probe)],
+                   capture_output=True, check=True, timeout=30)
+    return root
+
+
+@pytest.mark.parametrize("mode,timeout,result,elapsed", [
+    ("ready", 3000, "ready", 0),
+    ("ready", 120000, "ready", 0),
+    ("late", 3000, "IllegalStateException", 3000),
+    ("late", 120000, "ready", 93500),
+    ("missing", 120000, "IllegalStateException", 120000),
+    ("foreign", 3000, "IllegalStateException", 3000),
+    ("cancel", 120000, "SecurityException", 1000),
+    ("denied", 120000, "SecurityException", 0),
+    ("slow_read", 120000, "IllegalStateException", 120001),
+    ("clock_back", 120000, "IllegalStateException", -1),
+    ("ready", 120001, "IllegalArgumentException", 0),
+])
+def test_foreground_confirmation_is_read_only_bounded_and_fenced(readiness_classes, mode, timeout, result, elapsed):
+    completed = subprocess.run(["java", "-cp", str(readiness_classes), "Probe", mode, str(timeout)],
+                               text=True, capture_output=True, check=True, timeout=5)
+    assert completed.stderr == ""
+    assert completed.stdout.startswith(f"{result} time={elapsed} ")
+    if mode in {"ready", "denied", "slow_read", "clock_back"}:
+        assert f"reads={0 if timeout == 120001 else 1} " in completed.stdout
